@page
@model ScheduleServer.Pages_Lessons.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form asp-page="./Index" method="get" class="mb-4 row g-3 align-items-center">
    <div class="col-auto">
        <label class="col-form-label fw-bold">Показать группу:</label>
    </div>
    <div class="col-auto">
        <select name="groupId" class="form-select" style="min-width: 250px;" asp-items="Model.GroupsSelectList">
            <option value="">-- Все группы --</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Применить</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].Discipline)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].WorkloadType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].Teacher)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].LessonStart)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].LessonEnd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lesson[0].Group)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Lesson) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Discipline)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkloadType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Teacher)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LessonStart)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LessonEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Group.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
