@page
@model ScheduleServer.Pages_Updates.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Update</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Update.Id" />
            <div class="form-group">
                <label asp-for="Update.GroupId" class="control-label"></label>
                <select asp-for="Update.GroupId" class="form-control" asp-items="ViewBag.GroupId" ></select>
                <span asp-validation-for="Update.GroupId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Update.LastUpdate" class="control-label"></label>
                <input asp-for="Update.LastUpdate" class="form-control" />
                <span asp-validation-for="Update.LastUpdate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Update.WeekStart" class="control-label"></label>
                <input asp-for="Update.WeekStart" class="form-control" />
                <span asp-validation-for="Update.WeekStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
